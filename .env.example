# Copy to .env and fill in real values.
# Tenant/client/secret come from your Azure AD app registration; the API and
# subscription scope app-IDs come from your Dataceen onboarding details.

DATACEEN_TENANT_ID=00000000-0000-0000-0000-000000000000
DATACEEN_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATACEEN_CLIENT_SECRET=replace-me

DATACEEN_DOMAIN=YourDomain
DATACEEN_MODEL=YourModel
DATACEEN_SCOPE=All

DATACEEN_API_URL=https://api.dataceen.com
DATACEEN_API_PATH=/graphql
DATACEEN_API_SCOPE=api://00000000-0000-0000-0000-000000000000/.default

DATACEEN_SUBSCRIPTION_URL=https://subscription.dataceen.com
DATACEEN_SUBSCRIPTION_SCOPE=api://00000000-0000-0000-0000-000000000000/.default
